# R36S / RK3326 lean bring-up kernel fragment
# Deliberately paired with ARCH=arm64 tinyconfig.  The stock arm64 defconfig
# produces a ~39 MiB raw Image, which cannot fit the G80CA BOOT partition.
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_SMP=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
# CONFIG_MODULES is not set

# Minimal userspace / initramfs support
CONFIG_BINFMT_ELF=y
CONFIG_UNIX=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Console / bring-up visibility
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Core device-tree / GPIO / pinctrl / regulators
CONFIG_OF=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_RK808=y
CONFIG_ROCKCHIP_IODOMAIN=y

# Storage and filesystems
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# DRM / display
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_PANEL_GENERIC_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y

# GPU
CONFIG_DRM_PANFROST=y
CONFIG_PM=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

# Input / analogue sticks
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_ADC=y
CONFIG_INPUT_MISC=y
CONFIG_JOYSTICK_ADC=y
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_MUX=y
CONFIG_MUX_GPIO=y
CONFIG_ROCKCHIP_SARADC=y

# RK817 PMIC / power
CONFIG_I2C=y
CONFIG_MFD_RK8XX=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_POWER_SUPPLY=y
CONFIG_CHARGER_RK817=y

# Thermal / clocks / OPPs
CONFIG_THERMAL=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y

# USB used during bring-up
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y

# Audio stays built-in; this is still the real CFW kernel, not a display-only hack.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SIMPLE_CARD=y

# Debug filesystem is useful once userspace is up.
CONFIG_DEBUG_FS=y
# CONFIG_DEBUG_INFO is not set
